# Safety: use dry-run until IMAP discovery and archive destination are verified.
APP_MODE=dry-run
LOG_LEVEL=info
DATABASE_PATH=/data/mailbot.sqlite
BACKUP_DIR=/data/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=7
# Completed local records only; Exchange mail is never deleted by retention cleanup.
DATA_RETENTION_DAYS=90
MAIL_RULES_PATH=
HONORIFICS_PATH=/app/config/honorifics.json
USER_PROFILE_PATH=/app/config/user-profile.json
MAIL_ACCOUNT_FILES=/app/config/account-orchid.env,/app/config/account-axon.env
HEALTH_PORT=8080

IMAP_RECONCILE_SECONDS=300
# Test only. Keep 0 in production; set 1 or 2 for a bounded dry-run.
TEST_IMPORT_LIMIT=0
THREAD_MAX_MESSAGES=30
# Reject on-demand transfer/forward of any single file above this size.
MAX_ATTACHMENT_BYTES=25000000

TELEGRAM_BOT_TOKEN=change-me
TELEGRAM_USER_ID=123456789
TELEGRAM_REFRESH_HOURS=36
TELEGRAM_INITIAL_IMPORT_SILENT=false

# Voice instructions are downloaded and processed in memory only.
VOICE_REPLY_ENABLED=false
VOICE_MAX_SECONDS=180
VOICE_MAX_BYTES=10000000
VOICE_KEEP_AUDIO=false
STT_BASE_URL=https://ai-proxy.example.com/v1
STT_API_KEY=change-me
STT_MODEL_ORDER=local-qwen3-asr-1.7b,local-whisper-large-v3
STT_LANGUAGE=auto
STT_TIMEOUT_MS=90000

AI_ENABLED=true
AI_PROVIDER_ORDER=ollama,proxy
AI_TIMEOUT_MS=45000
AI_CONTEXT_MAX_CHARS=60000
# Separate, stricter limit for in-memory document text extraction.
AI_ATTACHMENT_MAX_BYTES=10000000
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:14b
AI_PROXY_BASE_URL=https://ai-proxy.example.com/v1
AI_PROXY_API_KEY=change-me
AI_PROXY_MODEL=local-gpt-oss-120b
AI_PROXY_MODEL_ORDER=local-gpt-oss-120b,local-gemma4-26b
# Fast transcript judge first; regular email analysis/drafting keeps the order above.
AI_TRANSCRIPT_MODEL_ORDER=local-gemma4-26b,local-gpt-oss-120b

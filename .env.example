# Safety: use dry-run until IMAP discovery and archive destination are verified.
APP_MODE=dry-run
LOG_LEVEL=info
DATABASE_PATH=/data/mailbot.sqlite
HEALTH_PORT=8080

IMAP_HOST=exchange.example.internal
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=DOMAIN\\username
IMAP_PASSWORD=change-me
IMAP_MAILBOX=INBOX
# Set only after running mailbox discovery and confirming the exact folder.
IMAP_ARCHIVE_MAILBOX=
IMAP_SENT_MAILBOX=Sent
IMAP_RECONCILE_SECONDS=300
# Test only. Keep 0 in production; set 1 or 2 for a bounded dry-run.
TEST_IMPORT_LIMIT=0

SMTP_HOST=exchange.example.internal
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=DOMAIN\\username
SMTP_PASSWORD=change-me
SMTP_FROM=user@example.com

TELEGRAM_BOT_TOKEN=change-me
TELEGRAM_USER_ID=123456789
TELEGRAM_REFRESH_HOURS=36
TELEGRAM_INITIAL_IMPORT_SILENT=false

AI_ENABLED=true
AI_PROVIDER_ORDER=ollama,proxy
AI_TIMEOUT_MS=30000
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:14b
AI_PROXY_BASE_URL=https://ai-proxy.example.com/v1
AI_PROXY_API_KEY=change-me
AI_PROXY_MODEL=gpt-oss-120b

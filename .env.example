# Safety: use dry-run until IMAP discovery and archive destination are verified.
APP_MODE=dry-run
LOG_LEVEL=info
DATABASE_PATH=/data/mailbot.sqlite
BACKUP_DIR=/data/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=7
# Completed local records only; Exchange mail is never deleted by retention cleanup.
DATA_RETENTION_DAYS=90
MAIL_RULES_PATH=
HEALTH_PORT=8080

IMAP_HOST=exchange.example.internal
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=DOMAIN\\username
IMAP_PASSWORD=change-me
IMAP_MAILBOX=INBOX
# Set only after running mailbox discovery and confirming the exact folder.
IMAP_ARCHIVE_MAILBOX=
# Confirm this exact path with mailbox discovery; Exchange commonly uses Sent Items.
IMAP_SENT_MAILBOX=Sent Items
IMAP_RECONCILE_SECONDS=300
# Test only. Keep 0 in production; set 1 or 2 for a bounded dry-run.
TEST_IMPORT_LIMIT=0
THREAD_MAX_MESSAGES=30
# Reject on-demand transfer/forward of any single file above this size.
MAX_ATTACHMENT_BYTES=25000000

SMTP_HOST=exchange.example.internal
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=DOMAIN\\username
SMTP_PASSWORD=change-me
SMTP_FROM=user@example.com

TELEGRAM_BOT_TOKEN=change-me
TELEGRAM_USER_ID=123456789
TELEGRAM_REFRESH_HOURS=36
TELEGRAM_INITIAL_IMPORT_SILENT=false

AI_ENABLED=true
AI_PROVIDER_ORDER=ollama,proxy
AI_TIMEOUT_MS=15000
AI_CONTEXT_MAX_CHARS=60000
# Separate, stricter limit for in-memory document text extraction.
AI_ATTACHMENT_MAX_BYTES=10000000
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:14b
AI_PROXY_BASE_URL=https://ai-proxy.example.com/v1
AI_PROXY_API_KEY=change-me
AI_PROXY_MODEL=gpt-oss-120b

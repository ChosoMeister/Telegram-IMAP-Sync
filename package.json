{
  "name": "telegram-imap-sync",
  "version": "0.6.0",
  "private": true,
  "description": "A single-user Telegram action inbox for Exchange IMAP mailboxes",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "discover": "node dist/discover.js",
    "preflight": "node dist/preflight.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "docs:check": "node scripts/check-docs.mjs",
    "check": "npm run lint && npm run test && npm run build && npm run docs:check"
  },
  "dependencies": {
    "deepmerge-ts": "8.0.1",
    "imapflow": "^1.0.194",
    "mailparser": "^3.7.4",
    "mammoth": "^1.12.1",
    "nodemailer": "^9.0.5",
    "pdf-parse": "^2.4.5",
    "sanitize-html": "^2.17.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^8.0.1",
    "@types/sanitize-html": "^2.16.0",
    "eslint": "^9.34.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "deepmerge-ts": "8.0.1"
  }
}
